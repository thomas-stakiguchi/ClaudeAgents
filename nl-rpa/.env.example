APP_NAME=nl-rpa
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=${NL_RPA_DATA_DIR}/database.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# データの置き場（リポジトリの外。絶対パス）。ログ・セッション・DB・記録はここに入る
# リポジトリの外の、絶対パス。例（Linux）：/home/you/nlrpa-data　例（Windows）：C:\Users\you\nlrpa-data
NL_RPA_DATA_DIR=

# ブラウザ部品：fake（Chromeを使わない偽の部品）か、chrome（本物のChrome。stubs/web/ のスタブ画面だけに接続）
# 切り替えると、もう一方のドライランは、無効になります（仕様9-2）
NL_RPA_BROWSER=fake
# Chromeの実行ファイル（未指定なら、自動検出）
NL_RPA_CHROME=
# rootで動かす環境（コンテナなど）のときだけ true。接続先の制限とは、無関係
NL_RPA_CHROME_NO_SANDBOX=false
# 許可するChromeのメジャーバージョン（カンマ区切り。未指定なら、確認しない）
NL_RPA_CHROME_MAJOR=
# スタブの画面（Web版）のポート。アプリ自身（8080）とは、別にする
NL_RPA_STUB_PORT=8081
