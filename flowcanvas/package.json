{
  "name": "flowcanvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b",
    "import": "tsx scripts/flow-import.ts",
    "template": "tsx scripts/flow-template.ts",
    "dump": "tsx scripts/xlsx-dump.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "html-to-image": "^1.11.13",
    "immer": "^11.2.9",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
